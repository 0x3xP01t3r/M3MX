# M3MX — files NOT to send to the Docker build context.
#
# Real settings and secrets never enter the build context.
config.json
.m3mx/
state/
tests/
docs/
**/.pytest_cache/
.coverage

.git
.gitignore
.gitattributes
.github/
.venv/
venv/
env/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python cruft
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# AI assistant config
.claude/
.codex
CLAUDE.md
.aider*

# Local secrets
.env
.env.local
.env.*

# Runtime data (mounted at runtime instead)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Memory images (just in case)
*.raw
*.mem
*.dmp
*.vmem
*.lime
*.img

# Logs
*.log

# Misc
*.bak
*~
*.tmp
