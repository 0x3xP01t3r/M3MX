#!/usr/bin/env python3
# M3MX — Volatility 3 launcher.
# Thin shim around the pip-installed volatility3 package so config.json
# can point at a stable in-repo path (bin/vol) instead of whatever
# PATH happens to look like at runtime.
import sys
from volatility3.cli import main
if __name__ == "__main__":
    sys.exit(main())
