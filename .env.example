# M3MX — example environment file.
# Copy to `.env` (or export in your shell) and fill in keys you actually want.
# `.env` is gitignored. Settings in config.json take precedence over these.

# --- LLM providers (any subset; only providers you'll use need keys) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GLM_API_KEY=
AGENTROUTER_API_KEY=

# --- Threat-intel (used by the agent's threat_intel tool) ---
ABUSEIPDB_API_KEY=
VT_API_KEY=

# --- Feature flags (override config.json features.*) ---
# Accepted: 1/0, true/false, yes/no, on/off. Unset = use config.json default.
FULL_ANALYSIS_V2=
FULL_ANALYSIS_LEGACY_V1=
FULL_ANALYSIS_OPTIONAL_AI_REPORT=

# --- Volatility ---
# Override the bundled bin/vol and bin/vol2 paths (rarely needed).
# VOL3_PATH=/app/bin/vol
# VOL2_PATH=/app/bin/vol2

# Always-on Vol3 flag for partial dumps; baked into the runner — no need to set.
# VOL3_ALLOW_PARTIAL_DUMP=1
